{
  "manifest_version": 2.0,
  "type": "widget",
  "id": "multigraphwidget",
  "name": "Multigraph",
  "namespace": "Multigraph",
  "version": "0.1.8-draft",
  "author": "lukas@plachy.eu",
  "description": "Enhanced multi-graph visualization with regex item matching",
  "url": "https://github.com/rheingold/zabbix_addons",
  "widget": {
    "size": {
      "width": 36,
      "height": 5
    },
    "js_class": "CWidgetMultigraph"
  },
  "actions": {
    "widget.multigraphwidget.view": {
      "class": "WidgetView"
    },
    "widget.multigraphwidget.rescan": {
      "class": "ModuleRescan"
    },
    "widget.multigraphwidget.itemlist": {
      "class": "ItemList"
    }
  },
  "assets": {
    "js": ["class.widget.js"],
    "css": ["multigraph.css"]
  }
}
