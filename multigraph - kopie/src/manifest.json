{
  "manifest_version": 2.0,
  "id": "multigraph",
  "type": "widget",
  "name": "Multigraph",
  "namespace": "Multigraph",
  "version": "1.2",
  "description": "Multi-item graph with regex/wildcard pattern matching",
  "widget": {
    "size": {
      "width": 12,
      "height": 5
    },
    "js_class": "CWidgetMultigraph"
  },
  "actions": {
    "widget.multigraph.view": {
      "class": "WidgetView"
    },
    "widget.multigraph.edit": {
      "class": "WidgetEdit"
    }
  },
  "assets": {
    "js": ["class.widget.js"]
  }
}
